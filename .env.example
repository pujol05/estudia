# Database connection (see prisma/schema.prisma). src/lib/prisma.ts caps the pg
# pool at 1 connection per instance, since serverless functions open a new pool
# per cold start — no extra pooling setup needed here beyond that.
DATABASE_URL=

# better-auth. BETTER_AUTH_SECRET must be a long random string, unique per environment
# (e.g. `openssl rand -base64 32`). BETTER_AUTH_URL is the app's public base URL —
# better-auth automatically trusts this origin, so it must exactly match the
# production URL (including https://, no trailing slash).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="http://localhost:3000"
# Optional, comma-separated. Extra origins to trust beyond BETTER_AUTH_URL
# (e.g. a custom domain plus the default *.vercel.app one).
BETTER_AUTH_TRUSTED_ORIGINS=

# Server-only contact form configuration. Never prefix these with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Estudia <contacte@your-domain.com>"
# Optional. Falls back to CONTACT_FROM_EMAIL when omitted.
AUTH_FROM_EMAIL="Estudia <no-reply@your-domain.com>"

# Cloudflare Turnstile. The site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
